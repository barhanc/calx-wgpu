{
  "name": "calx-wgpu",
  "version": "0.1.0",
  "description": "Pure WebGPU inference runtime for PyTorch ExecuTorch .pte models in TypeScript",
  "main": "./dist/index.cjs",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "vite example",
    "build:example": "vite build example",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "pytorch",
    "executorch",
    "webgpu",
    "wgsl",
    "deep-learning",
    "browser-ml"
  ],
  "author": "Bartosz Hanc <bartosz.hanc02@gmail.com>",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.5.3",
    "eslint-plugin-prettier": "^5.5.6",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "webgpu": "^0.6.1"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/barhanc/calx-wgpu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barhanc/calx-wgpu.git"
  },
  "bugs": {
    "url": "https://github.com/barhanc/calx-wgpu/issues"
  }
}
